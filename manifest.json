{
  "manifest_version": 3,
  "name": "Colonist Session Collector",
  "version": "0.1.3",
  "description": "Record your Colonist session's game messages locally for replay research.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "unlimitedStorage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Colonist Session Collector" },
  "content_scripts": [
    {
      "matches": ["https://colonist.io/*", "https://*.colonist.io/*"],
      "js": ["capture.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://colonist.io/*", "https://*.colonist.io/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ]
}
