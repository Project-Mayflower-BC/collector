{
  "manifest_version": 3,
  "name": "Colonist Session Collector",
  "version": "0.4.0",
  "description": "Record your Colonist session's game messages locally for replay research.",
  "minimum_chrome_version": "118",
  "permissions": ["debugger", "storage", "unlimitedStorage", "downloads", "offscreen"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Colonist Session Collector" }
}
